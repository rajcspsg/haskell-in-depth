cabal-version: 3.14
name:           stockquotes
version:        0.5
synopsis:       Examples to accompany the book "Haskell in Depth"
description:    This package provides source code examples which accompany the book "Haskell in Depth" by Vitaly Bragilevsky (Manning Publications 2020). You may want to get this package via @cabal get hid-examples@ and explore its content.
category:       Sample Code
homepage:       https://github.com/bravit/hid-examples#readme
bug-reports:    https://github.com/bravit/hid-examples/issues
author:         Vitaly Bragilevsky
maintainer:     Vitaly Bragilevsky <vit.bragilevsky@gmail.com>
license:        BSD-3-Clause
license-file:   LICENSE
tested-with:
    GHC == 9.14.1
build-type: Custom
extra-source-files:
    ChangeLog.md
    LICENSE
    README.md
    stack.yaml
    package.yaml
data-files:
    data/quotes.csv

source-repository head
  type: git
  location: https://github.com/bravit/hid-examples

flag with-pg
  manual: True
  default: False

custom-setup
    setup-depends:
        base >= 4.12 && < 5,
        Cabal >= 3.0 && < 4

executable stockquotes
  main-is: Main.hs
  other-modules:
  other-modules:
      Charts
      HtmlReport
      Params
      StatReport
      QuoteData
  hs-source-dirs:
      app
  other-extensions:
      RecordWildCards
      OverloadedStrings
      DeriveGeneric
      DeriveAnyClass
  ghc-options: -Wall -Werror -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wno-unused-top-binds -Wno-orphans -Wno-error=unrecognised-warning-flags
  build-depends:
      Chart >=1.9.5 && <1.10
    , Chart-diagrams >=1.9.5 && <1.10
    , base >=4.12 && <5
    , blaze-colonnade >=1.1 && <1.3
    , blaze-html == 0.9.*
    , bytestring >=0.10 && <0.13
    , cassava ==0.5.*
    , colonnade >=1.1 && <1.3
    , fmt >=0.5 && <0.7
    , optparse-applicative >=0.14 && <= 0.19
    , text >=1.2 && < 2.2
    , time >=1.15 && < 1.17
  default-language: GHC2024
